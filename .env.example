# Legacy dotenv format (kept for reference / tooling that reads `.env`).
# For Cloudflare Workers local dev, the real file is `.dev.vars`.

# OpenRouter — powers Persian sentence explanations (chat model).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-chat

# Speech-to-text is handled by the Workers AI binding ([ai] in wrangler.toml).
# No GROQ_API_KEY or other external STT provider is required.
