# Legacy dotenv format (kept for reference / tooling that reads `.env`).
# For Cloudflare Workers local dev, the real file is `.dev.vars`.

# OpenRouter — fallback for Persian sentence explanations (chat) and transcription
# (audio) when the Workers AI free tier hits its daily neuron limit.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-chat
# Audio-capable model used only when Workers AI Whisper is quota-limited.
OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# Groq — primary speech-to-text (whisper-large-v3-turbo) with precise word/segment
# timestamps, and the reliable text-AI fallback (reachable from Workers egress).
# Free key from console.groq.com. When unset, transcription/text fall back to the
# Workers AI [ai] binding, then OpenRouter.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=openai/gpt-oss-120b   (default text fallback model)
