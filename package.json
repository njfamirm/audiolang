{
  "name": "audiolang",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AudioLang — audio-first English learning on Cloudflare Workers + KV + Workers AI Whisper",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "predev": "mkdir -p web/dist",
    "dev:api": "wrangler dev --port 3001",
    "dev:web": "vite web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build web",
    "deploy": "npm run build && wrangler deploy",
    "diff": "bash scripts/diff.sh",
    "preview": "vite preview web"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wrangler": "^4.0.0"
  }
}